# EmailJS credentials — required for the Contact form to actually send email.
# Get these from https://dashboard.emailjs.com (Email Services / Email Templates / Account > API Keys).
# Copy this file to .env.local and fill in real values; .env.local is gitignored.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
